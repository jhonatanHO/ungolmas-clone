{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["resources/*"],
      "@ugm-core/*": ["packages/core/*"],
      "@ugm-integrations/*": ["packages/integrations/*"]
    }
  },
  "include": [
    "resources/**/*.ts",
    "resources/**/*.vue",
    "packages/**/*.ts",
    "packages/**/*.vue",
    "vite.config.ts"
  ]
}
