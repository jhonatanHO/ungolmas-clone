{
  "name": "ungolmas-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "format": "prettier --write .",
    "format:blade": "blade-formatter --write \"resources/**/*.blade.php\" \"packages/**/resources/views/**/*.blade.php\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "pinia": "^2.3.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/vue3": "8.6.14",
    "@storybook/vue3-vite": "8.6.14",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "blade-formatter": "^1.42.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^9.1.7",
    "laravel-vite-plugin": "^1.2.0",
    "lint-staged": "^15.2.11",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "storybook": "8.6.14",
    "storybook-dark-mode": "4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.0"
  },
  "lint-staged": {
    "*.php": [
      "./vendor/bin/pint"
    ],
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.blade.php": [
      "blade-formatter --write"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100
  }
}
