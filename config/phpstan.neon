includes:
    - ../vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - ../app
        - ../packages
    level: 8
    configDirectories:
        - %currentWorkingDirectory%/config
        - %currentWorkingDirectory%/packages/core/*/config
        - %currentWorkingDirectory%/packages/integrations/*/config
    excludePaths:
        - ../packages/*/*/vendor/*
        - ../packages/*/*/node_modules/*
        - ../tests/*
